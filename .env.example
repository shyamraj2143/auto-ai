# Auto-AI environment
ENVIRONMENT=development
SECRET_KEY=change-me-generate-a-long-random-value
JWT_SECRET_KEY=
FRONTEND_URL=https://autoai.site.je
BACKEND_URL=
BACKEND_CORS_ORIGINS=https://autoai.site.je,https://www.autoai.site.je
BACKEND_CORS_ORIGIN_REGEX=

# Deployment-to-Android release automation (values are hosting/CI secrets)
FORCE_UPDATE_ON_EVERY_PRODUCTION_DEPLOY=true
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
DEPLOYMENT_CALLBACK_SECRET=
APK_RELEASE_REPOSITORY=shyamraj2143/auto-ai
APK_RELEASE_INTERNAL_TOKEN=
ANDROID_PACKAGE_NAME=com.autoai.app
ANDROID_SIGNING_KEY_ALIAS=
ANDROID_SIGNING_STORE_PASSWORD=
ANDROID_SIGNING_KEY_PASSWORD=

# Frontend motion
VITE_ENABLE_CINEMATIC_WEBSITE=false
VITE_ENABLE_ADVANCED_MOTION=false
VITE_CRYSTAL_UI_ENABLED=false

# Database
DB_BACKEND=sqlite
SQLITE_PATH=database/auto_ai.db
DATABASE_URL=
MYSQL_URL=
MONGODB_URL=
MONGODB_DATABASE=auto_ai

# AI providers
AI_PROVIDER=groq

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_ALARM_MODEL=openai/gpt-oss-120b
GROQ_ALARM_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_ALARM_TIMEOUT_SECONDS=12
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_REQUEST_TIMEOUT_SECONDS=30
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4096
GROQ_RESEARCH_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b

# Web search
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_MAX_RESULTS=6
SEARCH_DEEP_MAX_RESULTS=10
SEARCH_COUNTRY=us,india
SEARCH_LANGUAGE=en,hindi
#hi

# OpenAI
AUTO_AI_OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Deep research
DEEP_RESEARCH_DEFAULT_MAX_MODELS=100
DEEP_RESEARCH_MAX_MODELS=100
DEEP_RESEARCH_MAX_INPUT_TOKENS=6000
DEEP_RESEARCH_MAX_OUTPUT_TOKENS=1200
DEEP_RESEARCH_PER_MODEL_TIMEOUT_SECONDS=45
DEEP_RESEARCH_RATE_LIMIT_PER_MINUTE=8
DEEP_RESEARCH_GROQ_TPM_BUDGET=7600
DEEP_RESEARCH_JUDGE_PROVIDER=groq
DEEP_RESEARCH_JUDGE_MODEL=
ORCHESTRATION_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant,qwen/qwen3-32b,meta-llama/llama-4-scout-17b-16e-instruct
ORCHESTRATION_INSTANT_FALLBACKS=openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
ORCHESTRATION_GROQ_CODING_MODEL=
ORCHESTRATION_INCLUDE_ALL_AVAILABLE_MODELS=true
ORCHESTRATION_MAX_PARALLEL=9
ORCHESTRATION_MAX_RETRIES=1
ORCHESTRATION_TOTAL_TIMEOUT_SECONDS=90
ORCHESTRATION_HEALTH_TTL_SECONDS=300
ORCHESTRATION_CIRCUIT_FAILURE_THRESHOLD=3
ORCHESTRATION_CIRCUIT_COOLDOWN_SECONDS=120
ORCHESTRATION_MAX_EVENTS_PER_GENERATION=500

# Security and limits
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=45
RATE_LIMIT_PER_MINUTE=90
RATE_LIMIT_LOGIN_PER_MINUTE=8
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_PAYMENT_PER_MINUTE=12
RATE_LIMIT_ADMIN_PER_MINUTE=30
RATE_LIMIT_RESTORE_PER_MINUTE=3
RATE_LIMIT_UPLOAD_PER_MINUTE=12
TRUSTED_HOSTS=["autoai.site.je","www.autoai.site.je"]
MAX_REQUEST_BODY_MB=110
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_MAX_ENTRIES=500
RESPONSE_CACHE_MAX_ITEM_CHARS=100000
PUBLIC_DEMO_CHAT_ENABLED=true
PUBLIC_DEMO_CHAT_LIMIT=5
PUBLIC_DEMO_CHAT_TTL_HOURS=24
MAX_UPLOAD_MB=20
FORM_SERVICE_STORAGE_DIR=backend/private/form-service
FORM_SERVICE_MAX_UPLOAD_MB=10
FORM_SERVICE_MAX_PDF_PAGES=50
DOCUMENT_OCR_MAX_PAGES=12

# Password reset email
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_FROM_NAME=Auto-AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# User-to-user calling. Redis and TURN are required for reliable production calls.
CALL_FEATURE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
TURN_PROVIDER=metered
METERED_DOMAIN=autoai.metered.live
METERED_TURN_API_KEY=
TURN_SERVER_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=
TURN_REALM=turn.example.com
TURN_CREDENTIAL_TTL=3600
CALL_RING_TIMEOUT_SECONDS=30
CALL_RECONNECT_GRACE_SECONDS=18
CALL_MAX_ATTEMPTS_PER_MINUTE=8
CALL_SEARCH_MAX_PER_MINUTE=30
CALL_SIGNAL_MAX_PER_MINUTE=360
CALL_ICE_MAX_PER_CALL=256
CALL_WS_TICKET_TTL_SECONDS=60
SCREEN_SHARE_GUEST_TOKEN_TTL_SECONDS=7200
SCREEN_SHARE_JOIN_MAX_PER_MINUTE=10
CALL_PRESENCE_TTL_SECONDS=55
RELATIONSHIP_FOLLOWUP_WORKER_ENABLED=true
RELATIONSHIP_FOLLOWUP_POLL_SECONDS=30
RELATIONSHIP_FOLLOWUP_BATCH_SIZE=50

