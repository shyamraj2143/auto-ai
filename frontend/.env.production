# Production API backend.
# The frontend is deployed as a separate Railway service, so browser/WebView/Android
# clients must use the backend service's public HTTPS endpoint directly.
# Do not point this at autoai.site.je unless that domain is explicitly attached to
# the backend service as its own Railway custom domain.
VITE_API_URL=https://auto-ai-app-download.up.railway.app/api/v1
VITE_CRYSTAL_UI_ENABLED=true
VITE_ENABLE_ADVANCED_MOTION=true
VITE_ENABLE_CINEMATIC_WEBSITE=true
