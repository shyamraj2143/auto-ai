# Production API backend.
# Use the public Auto-AI origin so browser/WebView/Android clients do not
# connect directly to the Railway service hostname. Nginx proxies /api/.
VITE_API_URL=https://autoai.site.je/api/v1
VITE_CRYSTAL_UI_ENABLED=true
VITE_ENABLE_ADVANCED_MOTION=true
VITE_ENABLE_CINEMATIC_WEBSITE=true
